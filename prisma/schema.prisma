// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  STUDENT
}

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum ExamType {
  SSC_CGL
  SSC_CHSL
  SSC_MTS
  SSC_CPO
  SSC_GD
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum LessonType {
  VIDEO
  ARTICLE
  PDF
}

enum Language {
  EN
  HI
}

enum AttemptType {
  PRACTICE
  MOCK
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum AccessTier {
  FREE
  PRO
  EXCLUSIVE
}

enum PurchasableItemType {
  MOCK_TEST
  PRACTICE_SET
  LESSON
  CHAPTER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum FeedbackType {
  ISSUE
  FEATURE_REQUEST
  TESTIMONIAL
}

enum FeedbackStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum ErrorSeverity {
  LOW // Warning — degraded UX, non-blocking
  MEDIUM // Error — feature broken, user can continue
  HIGH // Fatal — page/session unrecoverable
  CRITICAL // Crash — global error boundary triggered
}

enum ErrorReportStatus {
  UNRESOLVED // Default — needs attention
  IN_PROGRESS // Assigned, being investigated
  RESOLVED // Fixed and deployed
  IGNORED // Acknowledged, won't fix
  REGRESSED // Was RESOLVED, appeared again — auto-set by API
}

// ─── PERSONA & DEMOGRAPHICS ───────────────────────────────────────────────────

enum StudyPersona {
  FULL_TIME_ASPIRANT
  PART_TIME_ASPIRANT
  REPEAT_ASPIRANT
}

enum DailyStudyTime {
  LESS_THAN_2_HOURS
  TWO_TO_FOUR_HOURS
  MORE_THAN_4_HOURS
}

enum EducationLevel {
  HIGH_SCHOOL
  UNDERGRADUATE
  POSTGRADUATE
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum RankTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

// ─── USERS ────────────────────────────────────────────────────────────────────

model User {
  id              String  @id @default(cuid())
  name            String
  email           String  @unique
  passwordHash    String
  role            Role    @default(STUDENT)
  avatarUrl       String?
  phone           String?
  isEmailVerified Boolean @default(false)
  isActive        Boolean @default(true)

  // Streak & Gamification
  streakDays     Int         @default(0)
  lastActiveDate DateTime?
  xpPoints       Int         @default(0)
  rankTier       RankTier    @default(BRONZE)
  badges         UserBadge[]

  // OTP storage (for email verification & password reset)
  otpCode      String?
  otpExpiresAt DateTime?

  // Student profile (nullable — not applicable for admins)
  targetExam ExamType[]
  examYear   Int?
  city       String?

  // Demographics (all optional, student-only)
  age            Int?
  gender         Gender?
  educationLevel EducationLevel?
  occupation     String? // Free text: "Software Engineer", "CA Student", etc.
  incomeRange    String? // "< 3 LPA", "3-6 LPA", "> 6 LPA"

  // Persona signals (captured during onboarding)
  studyPersona       StudyPersona? // System-assigned, never shown to user
  dailyStudyTime     DailyStudyTime?
  hasAttemptedBefore Boolean         @default(false)

  // Onboarding state
  onboardingComplete Boolean @default(false)

  // Subscriptions & Monetization
  subscriptionTier      SubscriptionTier @default(FREE)
  subscriptionExpiresAt DateTime?

  // Social & Referrals
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("ReferredUsers", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("ReferredUsers")

  // Relations
  refreshTokens  RefreshToken[]
  lessonProgress LessonProgress[]
  testAttempts   TestAttempt[]
  enrollment     Enrollment?
  purchases      Purchase[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  feedbacks Feedback[]
  articles  Article[]  @relation("ArticleAuthor")

  // Error tracking relations
  lastAffectedErrors ErrorReport[] @relation("LastAffectedUser")
  assignedErrors     ErrorReport[] @relation("AssignedErrors")
  resolvedErrors     ErrorReport[] @relation("ResolvedErrors")

  // Content creator/updater relations
  createdQuestions    Question[]    @relation("QuestionCreator")
  updatedQuestions    Question[]    @relation("QuestionUpdater")
  updatedArticles     Article[]     @relation("ArticleUpdater")
  createdMockTests    MockTest[]    @relation("MockTestCreator")
  updatedMockTests    MockTest[]    @relation("MockTestUpdater")
  createdPracticeSets PracticeSet[] @relation("PracticeSetCreator")
  updatedPracticeSets PracticeSet[] @relation("PracticeSetUpdater")
  createdLessons      Lesson[]      @relation("LessonCreator")
  updatedLessons      Lesson[]      @relation("LessonUpdater")

  @@index([email])
  @@map("users")
}

// ─── REFRESH TOKENS ───────────────────────────────────────────────────────────

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  deviceInfo String?
  expiresAt  DateTime

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── EXAMS & SYLLABUS ─────────────────────────────────────────────────────────

model TargetExam {
  id          String  @id @default(cuid())
  name        String // e.g., "SSC CGL Tier 1"
  examYear    Int?
  description String?
  isActive    Boolean @default(true)

  syllabusNodes SyllabusNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("target_exams")
}

model SyllabusNode {
  id         String     @id @default(cuid())
  targetExam TargetExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId     String

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId String

  chapter   Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId String?

  weightage Float @default(1.0)
  order     Int   @default(0)

  @@unique([examId, subjectId, chapterId])
  @@index([examId])
  @@index([subjectId])
  @@map("syllabus_nodes")
}

// ─── SUBJECTS ─────────────────────────────────────────────────────────────────

model Subject {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  iconUrl     String?
  description String?
  examTypes   ExamType[]
  order       Int        @default(0)
  isActive    Boolean    @default(true)

  syllabusNodes SyllabusNode[]

  chapters     Chapter[]
  lessons      Lesson[]
  questions    Question[]
  practiceSets PracticeSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subjects")
}

// ─── CHAPTERS ─────────────────────────────────────────────────────────────────

model Chapter {
  id          String     @id @default(cuid())
  subject     Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId   String
  name        String
  slug        String
  description String?
  sectionName String?
  examTypes   ExamType[]
  order       Int        @default(0)
  accessTier  AccessTier @default(FREE)
  isActive    Boolean    @default(true)

  syllabusNodes SyllabusNode[]

  lessons      Lesson[]
  questions    Question[]
  practiceSets PracticeSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("chapters")
}

// ─── LESSONS ──────────────────────────────────────────────────────────────────

model Lesson {
  id           String     @id @default(cuid())
  chapter      Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  chapterId    String
  // Denormalized for fast subject-level queries
  subject      Subject    @relation(fields: [subjectId], references: [id])
  subjectId    String
  title        String
  slug         String
  type         LessonType
  videoUrl     String?
  articleHtml  String?
  pdfUrl       String?
  durationMins Int?
  thumbnailUrl String?
  order        Int        @default(0)
  accessTier   AccessTier @default(FREE)
  isActive     Boolean    @default(true)

  createdById String?
  createdBy   User?   @relation("LessonCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("LessonUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  progress     LessonProgress[]
  practiceSets PracticeSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, slug])
  @@index([chapterId])
  @@index([subjectId])
  @@map("lessons")
}

// ─── QUESTIONS ────────────────────────────────────────────────────────────────

model Question {
  id        String  @id @default(cuid())
  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String
  chapter   Chapter @relation(fields: [chapterId], references: [id])
  chapterId String

  questionText        String
  questionImageUrl    String?
  // JSON: [{ key: "A"|"B"|"C"|"D", text: string, imageUrl?: string }]
  options             Json
  correctOption       String // "A" | "B" | "C" | "D"
  explanation         String?
  explanationImageUrl String?

  difficulty Difficulty @default(MEDIUM)
  examTypes  ExamType[]
  pyqYear    Int?
  pyqShift   Int?
  pyqDate    DateTime?
  isPYQ      Boolean    @default(false)
  tags       String[]
  language   Language   @default(EN)
  isActive   Boolean    @default(true)

  createdById String?
  createdBy   User?   @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("QuestionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  practiceSets     PracticeSetQuestion[]
  mockTestSections MockTestSectionQuestion[]
  attemptResponses AttemptResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@index([chapterId])
  @@index([difficulty])
  @@index([isPYQ])
  @@map("questions")
}

// ─── PRACTICE SETS ────────────────────────────────────────────────────────────

model PracticeSet {
  id            String     @id @default(cuid())
  title         String
  subject       Subject    @relation(fields: [subjectId], references: [id])
  subjectId     String
  chapter       Chapter?   @relation(fields: [chapterId], references: [id])
  chapterId     String?
  lesson        Lesson?    @relation(fields: [lessonId], references: [id])
  lessonId      String?
  questionCount Int        @default(0)
  accessTier    AccessTier @default(FREE)
  order         Int        @default(0)
  isActive      Boolean    @default(true)

  createdById String?
  createdBy   User?   @relation("PracticeSetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("PracticeSetUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  questions PracticeSetQuestion[]
  attempts  TestAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subjectId])
  @@map("practice_sets")
}

// Join: PracticeSet ↔ Question (ordered)
model PracticeSetQuestion {
  practiceSet   PracticeSet @relation(fields: [practiceSetId], references: [id], onDelete: Cascade)
  practiceSetId String
  question      Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId    String
  order         Int         @default(0)

  @@id([practiceSetId, questionId])
  @@map("practice_set_questions")
}

// ─── MOCK TESTS ───────────────────────────────────────────────────────────────

model MockTest {
  id               String     @id @default(cuid())
  title            String
  examType         ExamType
  totalQuestions   Int
  totalMarks       Int
  durationMinutes  Int
  markingCorrect   Float      @default(2)
  markingIncorrect Float      @default(-0.5)
  markingSkipped   Float      @default(0)
  accessTier       AccessTier @default(FREE)
  isActive         Boolean    @default(true)
  scheduledAt      DateTime?

  createdById String?
  createdBy   User?   @relation("MockTestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?   @relation("MockTestUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  sections MockTestSection[]
  attempts TestAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examType])
  @@map("mock_tests")
}

model MockTestSection {
  id            String   @id @default(cuid())
  mockTest      MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  mockTestId    String
  name          String
  subjectId     String
  questionCount Int
  maxMarks      Int
  durationMins  Int?
  order         Int      @default(0)

  questions MockTestSectionQuestion[]

  @@index([mockTestId])
  @@map("mock_test_sections")
}

// Join: MockTestSection ↔ Question (ordered)
model MockTestSectionQuestion {
  section    MockTestSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId  String
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionId String
  order      Int             @default(0)

  @@id([sectionId, questionId])
  @@map("mock_test_section_questions")
}

// ─── TEST ATTEMPTS ────────────────────────────────────────────────────────────

model TestAttempt {
  id             String  @id @default(cuid())
  student        User?   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String?
  guestSessionId String?

  attemptType   AttemptType
  practiceSet   PracticeSet? @relation(fields: [practiceSetId], references: [id], onDelete: SetNull)
  practiceSetId String?
  mockTest      MockTest?    @relation(fields: [mockTestId], references: [id], onDelete: SetNull)
  mockTestId    String?

  status           AttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime      @default(now())
  submittedAt      DateTime?
  timeTakenSeconds Int?

  // Computed at submission — never trusted from client
  totalCorrect   Int?
  totalIncorrect Int?
  totalSkipped   Int?
  marksObtained  Float?
  accuracy       Float?
  percentile     Float?

  responses     AttemptResponse[]
  sectionScores AttemptSectionScore[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([studentId, mockTestId])
  @@index([studentId, practiceSetId])
  @@index([status])
  @@index([studentId, status, submittedAt(sort: Desc)])
  @@index([status, marksObtained(sort: Desc)])
  @@map("test_attempts")
}

model AttemptResponse {
  id               String      @id @default(cuid())
  attempt          TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId        String
  question         Question    @relation(fields: [questionId], references: [id])
  questionId       String
  selectedOption   String? // "A"|"B"|"C"|"D" or null = skipped
  isCorrect        Boolean?
  timeTakenSeconds Int?
  marksAwarded     Float       @default(0)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("attempt_responses")
}

model AttemptSectionScore {
  id            String      @id @default(cuid())
  attempt       TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId     String
  sectionId     String
  subjectId     String
  correct       Int
  incorrect     Int
  skipped       Int
  marksObtained Float

  @@unique([attemptId, sectionId])
  @@map("attempt_section_scores")
}

// ─── LESSON PROGRESS ──────────────────────────────────────────────────────────

model LessonProgress {
  id             String   @id @default(cuid())
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      String
  lesson         Lesson   @relation(fields: [lessonId], references: [id]) // Removed Cascade to protect progress
  lessonId       String
  completedAt    DateTime @default(now())
  watchedSeconds Int?

  @@unique([studentId, lessonId])
  @@index([studentId])
  @@index([studentId, completedAt(sort: Desc)])
  @@map("lesson_progress")
}

// ─── ENROLLMENTS ──────────────────────────────────────────────────────────────

model Enrollment {
  id        String           @id @default(cuid())
  student   User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String           @unique
  plan      SubscriptionPlan @default(FREE)
  examTypes ExamType[]
  startDate DateTime         @default(now())
  endDate   DateTime?
  isActive  Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enrollments")
}

// ─── COMMERCE & PURCHASES ─────────────────────────────────────────────────────

model Product {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  isActive    Boolean @default(true)

  // Persona targeting — admin-tagged for recommendation engine
  recommendedFor StudyPersona[]

  items     ProductItem[]
  purchases Purchase[]

  @@map("products")
}

model ProductItem {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  itemType PurchasableItemType
  itemId   String

  @@unique([productId, itemType, itemId])
  @@map("product_items")
}

model Purchase {
  id        String  @id @default(cuid())
  studentId String
  student   User    @relation(fields: [studentId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  amountPaid      Float
  status          PaymentStatus @default(PENDING)
  paymentGateway  String        @default("RAZORPAY")
  razorpayOrderId String?
  paymentRefId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([productId])
  @@map("purchases")
}

// ─── FEEDBACK & TESTIMONIALS ──────────────────────────────────────────────────

model Feedback {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       FeedbackType   @default(FEATURE_REQUEST)
  message    String
  questionId String? // If reporting an issue with a specific question
  isPublic   Boolean        @default(false)
  status     FeedbackStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@map("feedback")
}

// ─── CONTENT MANAGEMENT (CMS) ────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  articles    Article[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  contentMd       String    @db.Text
  metaTitle       String?
  metaDescription String?
  authorId        String?
  author          User?     @relation("ArticleAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("ArticleUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@map("articles")
}

// ─── ERROR REPORTING ────────────────────────────────────────────────────────

model ErrorReport {
  id String @id @default(cuid())

  // ── Fingerprint (unique per error type + route) ────────────────────
  // SHA-256 of (errorMessage + routePath + top stack frame)
  // One row per unique issue — occurrences are counted, not multiplied
  fingerprint String @unique

  // ── Classification ──────────────────────────────────────────
  severity ErrorSeverity     @default(MEDIUM)
  status   ErrorReportStatus @default(UNRESOLVED)

  // ── Occurrence Tracking (Sentry-style) ────────────────────────
  occurrenceCount   Int      @default(1) // Total times this error fired
  affectedUserCount Int      @default(0) // Distinct user count (approximate)
  firstSeenAt       DateTime @default(now())
  lastSeenAt        DateTime @default(now()) // Updated on each recurrence

  // ── Error Details ───────────────────────────────────────────
  message        String // e.g. "Cannot read properties of undefined"
  stack          String? // Full JS stack trace
  componentStack String? // React component tree at crash point
  errorBoundary  String? // "global" | "page" | "inline" | "server"

  // ── Location Context (critical for guest errors) ───────────────
  url         String // Full window.location.href
  routePath   String? // Next.js pathname template e.g. /pyq/[subject]/[chapter]
  routeParams Json? // Resolved params e.g. { subject: "reasoning" }
  userAgent   String? // Browser/OS/device
  appVersion  String? // git SHA or package.json version

  // ── User Impact ───────────────────────────────────────────────
  // Nullable — guest errors have no userId
  lastAffectedUserId String?
  lastAffectedUser   User?   @relation("LastAffectedUser", fields: [lastAffectedUserId], references: [id], onDelete: SetNull)

  // ── Assignment & Resolution (Industry Standard) ────────────────
  assignedToId String?
  assignedTo   User?     @relation("AssignedErrors", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?     @relation("ResolvedErrors", fields: [resolvedById], references: [id], onDelete: SetNull)
  notes        String? // Admin resolution notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([lastSeenAt]) // "Recent errors" queries
  @@index([affectedUserCount]) // "Most impactful" queries
  @@index([routePath]) // "Errors per route" analytics
  @@map("error_reports")
}

// ─── GAMIFICATION ─────────────────────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  iconUrl     String? // S3 URL or generic identifier
  criteria    String // E.g., "FIRST_TEST", "10_DAY_STREAK"
  users       UserBadge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}
