# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
API_VERSION=v1

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Supabase:  postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Railway:   postgresql://postgres:[PASSWORD]@[HOST]:5432/railway
# Local:     postgresql://postgres:password@localhost:5432/ssc_db
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ssc_db?schema=test

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-min-32-chars-access-secret
JWT_REFRESH_SECRET=change-me-min-32-chars-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail: use App Password (not your main password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=CodeZest <noreply@codezest.in>

# ─── Storage ──────────────────────────────────────────────────────────────────
# Option A — Cloudinary (recommended for images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option B — Cloudflare R2 (Recommended for zero egress fees)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001,https://admin.kwickly.in,https://kwickly.in

# ─── Sarvam AI (Translation) ──────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key